/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    qussai96/gap-flow Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params.download_tools = null
//params.config_tools = false
params.config_tools_folder = params.config_tools_folder ?: null //val: path to the config_tools folder (optional); in case the user has it already downloaded (through industrial license) and wants to use it instead of downloading it from the server
params.fragpipe_workflow = params.fragpipe_workflow ?: null

//MANIFEST
params.mode_type = 'DDA+'

//DECOY
params.decoy_tag = 'rev_'
params.add_contaminants = true // (posibility) to not add contaominant seq during DECOY process 

//MERGE
params.fasta_file = params.fasta_file ?: null

//WORKFLOW
params.workflow = 'Basic-Search'
params.'run-ionquant' = false

//FRAGPIPE
params.fragpipe_version = "23.1"
params.ram = 24
params.threads = 16

//Casanovo workflow 
params.peptide_identification = "casanovo"
params.peptide_score = 0.8
params.mzTab_casanovo = null

//params.fragpipe_tools_dir = "${projectDir}/fragpipe_tools"  // Directory to cache downloaded MSFragger/IonQuant/diaTracer tools

//gene_prediction workflow
params.genome_option = 'Tiberius' //default for gene_prediction
params.prediction_gff_file = null 

//HELIXER:
params.lineage_helixer = null // 'land_plant'

//TIBERIUS
params.model_cfg_tiberius = null //'angiosperms' //add tiberius to the name 

//VARUS
params.taxID = null // is default becaouse GAP-MS can run without BAM 
params.rna_seq_bam = null //if the user already has the file --> skips gar taxonomy & Varus

//reference_fasta_workflow
params.ref_gtf = null
params.ref_fasta = false 

//GAPMS
params.mapping = null
params.scores = null
params.iterative = null
params.output = "results" 
params.gtf = true


// Global default params, used in configs
params {

    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Contianer configurations 
singularity {
     enabled = true
     autoMounts = true
}

docker.enabled = false

//Cluster configurations

process {
    executor ='slurm'

    withName:'GAP_FLOW:fragpipe_workflow:AUTHENTICATION' {
        executor = 'local'
        container = null
        debug = true
    }

    withName:'GAP_FLOW:fragpipe_workflow:AUTHENTICATION_DOWNLOAD' {
        executor = 'local'
        container = null
        debug = true
    }
        
    withName:'GAP_FLOW:fragpipe_workflow:MANIFEST'{
        memory = 4.GB
        cpus = 1
    }

    withName:'GAP_FLOW:fragpipe_workflow:MERGE'{
        memory = 4.GB
        cpus = 1
    }

    withName:'GAP_FLOW:fragpipe_workflow:DECOY' {
        cpus = 8
        memory = 48.GB
        time = 6.h
    }

    withName:'GAP_FLOW:fragpipe_workflow:WORKFLOW' {
        memory = 4.GB
        cpus = 1
    }
    
    withName:'GAP_FLOW:fragpipe_workflow:FRAGPIPE' {
        //memory = 64.GB
        //cpus = 16
        queue = 'GPU-A40'
    }

    withName:'GAP_FLOW:casanovo_workflow:CASANOVO'{
        cpus = 16
        memory = 32.GB
        time = 26.h
        queue = 'GPU-A40'
        containerOptions = '--nv' 
        clusterOptions = '--gres=gpu:1'
    }

    withName:'GAP_FLOW:gene_prediction:TIBERIUS' {
        cpus = 8
        memory = 16.GB
        time = 60.h
        accelerator = 1
        queue = 'GPU-A40'
        runOptions = '--nv' 
        clusterOptions = '--gres=gpu:1'
    }

    withName:'GAP_FLOW:gene_prediction:HELIXER' { //the same gpu as casanovo
        cpus = 16
        memory = 64.GB
        time = 8.h
        queue = 'GPU-A40'
        runOptions = '--nv' 
        clusterOptions = '--gres=gpu:1'
    }

    withName:'GAP_FLOW:gene_prediction:GFF_GTF_TO_FAA' {
        cpus = 4
        memory = 16.GB
        wave {
            enabled = false
        }
    }

    withName:'GAP_FLOW:varus_workflow:GFF_GTF_TO_FAA' {
        cpus = 4
        memory = 8.GB
        wave {
            enabled = false
        }
    }

    withName:'GAP_FLOW:varus_workflow:BAM_TO_GTF' {
        cpus = 4
        memory = 8.GB
        wave {
            enabled = false
        }
    }

    withName:'GAP_FLOW:varus_workflow:TRANSDECODER' {
        cpus = 4
        memory = 8.GB
        wave {
            enabled = false
        }
    }

    withName:'GAP_FLOW:varus_workflow:GET_TAXONOMY' {
        memory = 4.GB
        cpus = 16
    }

    withName:'GAP_FLOW:varus_workflow:VARUS' {
        memory = 64.GB
        cpus = 16
        time   = '72h' //
    }

    withName: 'GAP_FLOW:GAPMS' {
        //memory = 32.GB
        //cpus = 16
        queue = 'GPU-A40'
    }

    withName: '.*THERMORAWFILEPARSER' {
        ext.args = '-f=1'
    }
}

singularity {
    enabled = true
    runOptions = '--nv -B /usr/bin/ps:/usr/bin/ps'
}


// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load qussai96/gap-flow custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load qussai96/gap-flow custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/gap-flow.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

//mail config
mail {
    enabled = true
    from = System.getenv('NXF_MAIL_FROM')
    host = System.getenv('NXF_MAIL_HOST')
    port = 587
    username = System.getenv('NXF_MAIL_USER')
    password = System.getenv('NXF_MAIL_PASSWORD')
    auth = true
    starttls.enable = true
}

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'qussai96/gap-flow'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Qussai Abbas',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Sonia Blaszczak',
            affiliation: '',
            email: '',
            github: 'https://github.com/sonia456',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/qussai96/gap-flow'
    description     = """A Nextflow pipeline for proteogenomics analysis, integrating peptide identification with FragPipe or Casanovo, gene prediction using Tiberius or Helixer, and optional VARUS-assisted genome annotation refinement, with downstream GAP-MS analysis."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
